# Copiá este archivo como ".env" y completá tus claves. El archivo .env NO se sube a Git.
# Nunca pegues claves reales en este archivo de ejemplo.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelos (opcionales). Si no los definís, se usan estos valores por defecto.
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_MODEL=gpt-4o-mini

# Proveedor por defecto de la CLI: anthropic | openai | mock
LLM_PROVIDER=anthropic
